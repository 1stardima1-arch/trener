DATABASE_URL="postgresql://user:password@localhost:5432/trener"

AUTH_SECRET="generate-with: openssl rand -base64 33"
NEXTAUTH_URL="http://localhost:3000"

# Шифрование токенов подключённых устройств (Polar/Athyx/Garmin) в базе —
# сгенерируй: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# Resend (вход по почте, письма поддержки) — https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Тренер <onboarding@resend.dev>"
SUPPORT_EMAIL="support@trener.app"

# Почты/ник, у которых при входе появляется админ-режим.
ADMIN_EMAILS=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ИИ для тренера — задай один из двух (Gemini используется первым, если
# заданы оба; Groq остаётся рабочим запасным вариантом).
# Gemini — ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Groq (быстрый бесплатный ИИ) — ключ: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google OAuth (вход через Google) — необязательно, кнопка появляется
# только если оба значения заданы. Создать: console.cloud.google.com/apis/credentials
# Authorized redirect URI: <твой домен>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Устройства ---

# Polar AccessLink — самостоятельная бесплатная регистрация (не нужна
# компания/железо): создай приложение на https://admin.polaraccesslink.com
POLAR_CLIENT_ID=""
POLAR_CLIENT_SECRET=""
# Необязательно — секрет для проверки подписи вебхука Polar (Settings в
# том же кабинете). Без него вебхук всё равно работает, просто без проверки подписи.
POLAR_WEBHOOK_SIGNATURE_SECRET=""

# Athyx — API-ключ создаёт сам атлет на athyx.com/developers и вставляет в
# приложении (страница «Устройства»), сюда ничего добавлять не нужно.

# Garmin — официальный Connect Developer Program сейчас закрыт для новых
# заявок, поэтому есть опциональная неофициальная синхронизация через тот
# же вход, что использует мобильное приложение Garmin Connect (как открытые
# проекты python-garminconnect/garth). Выключена по умолчанию — включай,
# только если понимаешь, что это не официальный API. GARMIN_CONSUMER_KEY/
# SECRET — те же значения, что используют open-source клиенты (см. их
# исходники), не публикуются здесь, так как Garmin их периодически меняет.
ENABLE_GARMIN_UNOFFICIAL_SYNC="false"
GARMIN_CONSUMER_KEY=""
GARMIN_CONSUMER_SECRET=""

# Секрет, которым Vercel Cron подписывает вызов /api/cron/daily-recompute
# (Vercel сам добавляет заголовок Authorization: Bearer $CRON_SECRET, если
# эта переменная задана в проекте) — сгенерируй: openssl rand -base64 24
CRON_SECRET=""
